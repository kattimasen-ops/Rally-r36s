<?xml version="1.0" ?>
<level 
	name="Helicoil"
	comment="Now you'll run in circles..."
	author="Marcio Bremm"
	description="difficult, monotonous, patience necessary"
	screenshot="ss.png"
	minimap="mm.png">
	
	<terrain
		heightmap="h.png"
		terrainmap="t.png"
		roadmap="r.png"
		colormap="c.png"
		foliagemap="f.png"
		hudmap="c.png"
		tilesize="16"
		horizontalscale="4"
		verticalscale="1.33"
		>
		
		<foliageband
			middle="0.5"
			range="0.5"
			density="0.001"
			sprite="/textures/veg/grass-sprite.png"
			spritecount="1"
			/>
	</terrain>
	
	<weather
		cloudtexture="/textures/sky/blue.jpg"
		cloudscrollrate="0"
		fogcolor="0.2, 0.2, 0.6"
		fogdensity="0.002"
		fogdensitysky="0.02"
		/>

	<vehicleoption type="/vehicles/seat/seat.vehicle" />
	<vehicleoption type="/vehicles/focus/focus.vehicle" />
	<vehicleoption type="/vehicles/evo/evo.vehicle" />
	
	<race coordscale="4, -4" targettime="1200">
		
		<startposition pos="256, 256" oridegrees="0" />
		<checkpoint coords="220, 254" />
		<checkpoint coords="195, 254" />
		<checkpoint coords="170, 254" />
		<checkpoint coords="145, 254" />
		<checkpoint coords="120, 254" />
		<checkpoint coords="095, 254" />
		<checkpoint coords="070, 254" />
		<checkpoint coords="045, 254" />
		<checkpoint coords="265, 485" />
	</race>
</level>
