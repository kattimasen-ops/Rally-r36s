<?xml version="1.0" ?>
<level 
	name="Roundhouse kicks"
	comment="Are you smart as Chuck Norris ?"
	author="Agnius Vasiliauskas"
	description="tight road, steep abyss, monotonous"
	screenshot="ss.png"
	minimap="mm.png">
	
	<terrain
		heightmap="h.png"
		terrainmap="t.png"
		roadmap="r.png"
		colormap="c.jpg"
		foliagemap="f.jpg"
		hudmap="c.jpg"
		tilesize="16"
		horizontalscale="5.2"
		verticalscale="0.1"
		>
		<foliageband
			middle="0.51"
			range="0.5"
			density="0.0002"
			sprite="/textures/veg/grass-sprite.png"
			spritecount="1"
			/>
		<foliageband
			middle="0.3"
			range="0.27"
			density="0.0000023"
			sprite="/textures/veg/cactus1.png"
			spritecount="2"
			scale="1.5"
			/>
		<foliageband
			middle="0.9"
			range="0.2"
			density="0.0000025"
			sprite="/textures/veg/palm-tree.png"
			spritecount="2"
			scale="10"
			/>
	</terrain>
	
	<weather
		cloudtexture="/textures/sky/blue.jpg"
		cloudscrollrate="0.003"
		fogcolor="0.9, 0.95, 1.0"
		fogdensity="0.006"
		fogdensitysky="0.5"
		/>
	
	<vehicleoption type="/vehicles/seat/seat.vehicle" />
	<vehicleoption type="/vehicles/focus/focus.vehicle" />
	
	<race coordscale="5.2, -5.2" targettime="130.0">
		
		<startposition pos="252, 216, 2.0" oridegrees="90" />
		<checkpoint coords="234, 220" />
		<checkpoint coords="215, 242" />
		<checkpoint coords="226, 286" />
		<checkpoint coords="270, 291" />
		<checkpoint coords="239, 230" />
		<checkpoint coords="225, 264" />
		<checkpoint coords="260, 283" />
		<checkpoint coords="269, 242" />
		<checkpoint coords="236, 250" />
		<checkpoint coords="263, 268" />
		<checkpoint coords="255, 261" />
	</race>
</level>
