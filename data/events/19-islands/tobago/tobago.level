<?xml version="1.0" ?>
<level
	name="Tobago"
	comment="Safari in the Caribbean"
	author="Andreas Rosdal"
	description="fast, even, partly throgh vegetation"
	screenshot="ss.png"
	minimap="mm.png">

	<terrain
		heightmap="h.png"
		colormap="c.jpg"
		foliagemap="f.png"
		hudmap="c.jpg"
		terrainmap="t.png"
		roadmap="r.png"
		tilesize="32"
		horizontalscale="3"
		verticalscale="0.05"
		>

		<foliageband
			middle="0.8"
			range="0.4"
			density="0.0001"
			sprite="/textures/veg/grass-sprite.png"
			spritecount="1"
			scale="0.25"
			/>

		<foliageband
			middle="0.8"
			range="0.3"
			density="0.0001"
			sprite="/textures/veg/palmy.png"
			spritecount="3"
			scale="0.35"
			/>
		<roadsign sprite="sun.png" scale="512">
			<location coords="256, 512" oridegrees="0" />
		</roadsign>
	</terrain>

	<weather
		cloudtexture="sky-sun.jpg"
		cloudscrollrate="0.003"
		fogcolor="0.9, 1, 1"
		fogdensity="0.002"
		fogdensitysky="0.8"
		/>

	<water
		height="0.4"
		watertexture="/textures/water/default.png"
		/>

	<vehicleoption type="/vehicles/seat/seat.vehicle" />
	<vehicleoption type="/vehicles/focus/focus.vehicle" />
	<vehicleoption type="/vehicles/evo/evo.vehicle" />

	<race coordscale="3, -3" targettime="195.0" codrivercpmode="free">

		<startposition pos="110, 192" oridegrees="0" />
		<checkpoint coords="221, 115" />
		<checkpoint coords="362, 74" />
		<checkpoint coords="287, 253" />
		<checkpoint coords="444, 200" />
		<checkpoint coords="480, 340" />
		<checkpoint coords="350, 466" />
		<checkpoint coords="300, 360" />
		<checkpoint coords="151, 415" />
		<checkpoint coords="60, 290" />
		<checkpoint coords="110, 192" />

		<codrivercp coords="110, 177" notes="easy right long" />
		<codrivercp coords="191, 124" notes="flat right into easy left" />
		<codrivercp coords="286, 91" notes="hard right long" />
		<codrivercp coords="352, 112" notes="easy left" />
		<codrivercp coords="325, 162" notes="easy right long into medium left long" />
		<codrivercp coords="286, 306" notes="medium left long" />
		<codrivercp coords="352, 297" notes="medium right into easy left" />
		<codrivercp coords="412, 232" notes="square right into medium right long" />
		<codrivercp coords="475, 257" notes="medium left into medium right long" />
		<codrivercp coords="455, 369" notes="easy left long" />
		<codrivercp coords="389, 431" notes="medium right long" />
		<codrivercp coords="331, 462" notes="medium right long into easy left long" />
		<codrivercp coords="203, 375" notes="hard right dont cut" />
		<codrivercp coords="136, 387" notes="easy left long" />
		<codrivercp coords="93, 315" notes="medium right long " />
		<codrivercp coords="67, 236" notes="medium left over finish" />

	</race>
</level>
