		<wheel drive="0.4" steer="0.7" brake1="800.0" pos="0.8, 1.15, -0.3" radius="0.42" force="80000.0" dampening="10000.0" friction="0.025"/>
		<wheel drive="0.4" steer="0.7" brake1="800.0" pos="-0.8, 1.15, -0.3" radius="0.42" force="80000.0" dampening="10000.0" friction="0.025"/>
		<wheel drive="0.6" steer="0.0" brake1="500.0" pos="0.8, -1.5, -0.35" radius="0.42" force="75000.0" dampening="11000.0" brake2="2000.0" friction="0.025"/>
		<wheel drive="0.6" steer="0.0" brake1="500.0" pos="-0.8, -1.5, -0.35" radius="0.42" force="75000.0" dampening="11000.0" brake2="2000.0" friction="0.025"/>

