<?xml version="1.0" ?>
<level
	name="Volcanic island"
	comment="Illa volcanica - Danger hot lava"
	author="Ivan"
	description="narrow road, sudden turns, rough terrain"
	screenshot="ss.png"
	minimap="mm.png">

	<terrain
		heightmap="h.png"
		terrainmap="t.png"
		roadmap="r.png"
		colormap="c.jpg"
		foliagemap="f.png"
		hudmap="c.jpg"
		tilesize="16"
		horizontalscale="3.0"
		verticalscale="0.09"
		>
		<foliageband
			middle="0.7"
			range="0.4"
			density="0.0002"
			sprite="/textures/veg/grass-sprite.png"
			spritecount="1"
			/>
		<foliageband
			middle="1.0"
			range="0.3"
			density="0.0001"
			sprite="/textures/veg/palmy.png"
			spritecount="3"
			/>
	</terrain>

	<water
		height="9"
		/>

	<vehicleoption type="/vehicles/seat/seat.vehicle" />
	<vehicleoption type="/vehicles/focus/focus.vehicle" />
	<vehicleoption type="/vehicles/evo/evo.vehicle" />

	<race coordscale="3.0, -3.0" targettime="200.0">
		<startposition pos="184, 84, 2.0" oridegrees="120" />
		<checkpoint coords="139, 146" />
		<checkpoint coords="108, 190" />
		<checkpoint coords="127, 237" />
		<checkpoint coords="74, 470" />
		<checkpoint coords="95, 436" />
		<checkpoint coords="142, 429" />
		<checkpoint coords="140, 346" />
		<checkpoint coords="177, 319" />
		<checkpoint coords="190, 349" />
		<checkpoint coords="235, 370" />
		<checkpoint coords="290, 418" />
		<checkpoint coords="424, 417" />
		<checkpoint coords="452, 318" />
		<checkpoint coords="375, 319" />
		<checkpoint coords="287, 253" />
		<checkpoint coords="251, 159" />
		<checkpoint coords="230, 99" />
		<checkpoint coords="187, 84" />
	</race>
</level>
