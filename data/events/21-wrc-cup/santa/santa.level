<?xml version="1.0" ?>
<level
	name="Santa Cruz"
	comment="Run against the clock"
	author="Marcio Bremm"
	description="easy, fast, wide, plain"
	screenshot="ss.png"
	minimap="mm.png">

	<terrain
		heightmap="h.png"
		terrainmap="t.png"
		roadmap="r.png"
		colormap="c.jpg"
		foliagemap="f.png"
		hudmap="c.jpg"
		tilesize="16"
		horizontalscale="4.0"
		verticalscale="0.15"
		>

		<foliageband
			middle="0.5"
			range="0.5"
			density="0.000500"
			sprite="/textures/veg/palmy.png"
			spritecount="0.5"
			/>

	</terrain>

	<weather
		cloudtexture="/textures/sky/overcast.jpg"
		cloudscrollrate="0.001"
		fogcolor="0.3, 0.3, 0.3"
		fogdensity="0.010"
		fogdensitysky="0.6"
		rain="2500.0"
		/>

	<vehicleoption type="/vehicles/seat/seat.vehicle" />

	<race coordscale="4.0, -4.0"
		targettime="180.0">

		<startposition pos="251, 396, 2.0" oridegrees="75" />

		<checkpoint coords="046, 329" />
		<checkpoint coords="056, 164" />
		<checkpoint coords="283, 170" />
		<checkpoint coords="237, 315" />
		<checkpoint coords="284, 351" />
		<checkpoint coords="471, 114" />
		<checkpoint coords="442, 342" />
		<checkpoint coords="455, 449" />
		<checkpoint coords="251, 396" />

	</race>

</level>
